# PdfSearch environment configuration
# Copy to .env and edit values. All variables have safe defaults.
# Secrets (SECRET_KEY, OPENAI_API_KEY) MUST be set.
# Never commit .env to Git.

# ---- Required secrets ----
SECRET_KEY=change-me-to-a-random-50-char-string
OPENAI_API_KEY=sk-your-key-here

# ---- Security posture ----
DEBUG=False
ALLOW_INSECURE_DEFAULTS=0
ALLOWED_HOSTS=localhost,127.0.0.1,ai-sahakar.net,www.ai-sahakar.net

# ---- Data paths (defaults use /app/data volume) ----
# DATA_ROOT=/app/data
# SQLITE_DB_PATH=/app/data/db.sqlite3
# MEDIA_ROOT=/app/data/media
# STATIC_ROOT=/app/data/staticfiles

# ---- AI model configuration ----
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# GOOGLE_API_KEY=

# ---- Bootstrap (first-run only) ----
CREATE_SUPERUSER=0
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
# FIXTURE_BACKUP=0
# RUN_JSON_MIGRATIONS=0

# ---- Data migration ----
IMPORT_LEGACY_DATA=0
DATA_BOOTSTRAP_MODE=strict
# DECLARED_SEED_DB=/app/init/db.sqlite3
# DECLARED_SEED_MEDIA=/app/init/media

# ---- Public search ----
PUBLIC_SEARCH_ENABLED=1
# PUBLIC_SEARCH_FOLDER_IDS=all
# PUBLIC_SEARCH_MAX_WORDS=30
# PUBLIC_SEARCH_RATE_LIMIT=30
# PUBLIC_SEARCH_RATE_WINDOW=60

# ---- UI ----
DISPLAY_SERVICE_FOOTER=0
# GUNICORN_WORKERS=4
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_TIMEOUT=300

# ---- Artifact vault (RustFS/S3) ----
ARTIFACT_VAULT_ENABLED=0
# ARTIFACT_VAULT_ENDPOINT=
# ARTIFACT_VAULT_BUCKET=
# ARTIFACT_VAULT_REGION=
# ARTIFACT_VAULT_ACCESS_KEY=
# ARTIFACT_VAULT_SECRET_KEY=

# ---- CORS / CSRF ----
# CORS_ALLOWED_ORIGINS=https://ai-sahakar.net,https://www.ai-sahakar.net
# CSRF_TRUSTED_ORIGINS=https://ai-sahakar.net,https://www.ai-sahakar.net,http://localhost:8000,http://127.0.0.1:8000

# ---- Compose-only (Docker deployment) ----
# WEB_PORT=8000
# PDFSEARCH_IMAGE=ghcr.io/nimble-esolutions/pdfsearch/shakar-frontend:latest
