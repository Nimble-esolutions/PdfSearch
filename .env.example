# FlowDocs Environment Variables
# Copy this to .env and fill in your values.
# .env is gitignored and never committed.

# Django
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=ai-sahakar.net,www.ai-sahakar.net,one.ai-sahakar.net

# Database (SQLite default for single-node deployment)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=flowdocs
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=db-host
# DB_PORT=5432

# API Keys (REQUIRED for AI search)
OPENAI_API_KEY=sk-your-openai-api-key

# Redis
REDIS_URL=redis://redis:6379/1

# CORS / CSRF (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://ai-sahakar.net,https://www.ai-sahakar.net
CSRF_TRUSTED_ORIGINS=https://ai-sahakar.net,https://www.ai-sahakar.net,https://one.ai-sahakar.net

# Optional
# SENTRY_DSN=https://your-sentry-dsn
# MAX_FILE_SIZE=10485760

# Docker / Dokploy
APP_UID=1000
APP_GID=1000
WEB_PORT=8000
DATA_PATH=/home/prodsahakar/flowdocs
