# FlowDocs (PdfSearch) environment reference.
# Copy for local development only. Set production values in Dokploy UI.
# Never commit a real .env file or values copied from production.
# New deployments should start from .env.dataops.example. The historical
# VAULT_ and ARTIFACT_VAULT_ entries below are compatibility-only during the
# cutover and must not be copied into a new Dokploy environment.

# Core Django settings
SECRET_KEY=<generate-and-store-in-dokploy-secret>
DEBUG=False
ALLOW_INSECURE_DEFAULTS=0
ALLOWED_HOSTS=ai-sahakar.net,www.ai-sahakar.net,dev.ai-sahakar.net,one.ai-sahakar.net,stagetwo.ai-sahakar.net,stagethree.ai-sahakar.net
DJANGO_SETTINGS_MODULE=flowdocs.settings

# ---- Environment Identity (all values validated at startup) ----
# This file is the local-development example. Use the reviewed examples under
# docs/environments/ for production and stage; never copy their data settings
# into a local environment.
APP_ENV=development

# DEPLOYMENT_ID: unique deployment identity (required in production)
DEPLOYMENT_ID=local-dev

# DATASET_ID: logical identity of the application dataset (required in production)
DATASET_ID=ai-sahakar-dev

# DATA_MODE: local | empty | seed | s3-restore | s3-pinned | exact-production
DATA_MODE=empty
RESTORE_SOURCE_DATASET_ID=
RESTORE_POLICY=manual

# BACKUP_ROLE: writer | reader | disabled
BACKUP_ROLE=disabled

# BACKUP_SYNC_MODE: manual | scheduled | hybrid
BACKUP_SYNC_MODE=manual

# EXTERNAL_SIDE_EFFECTS_MODE: enabled | disabled | sandbox
# Non-production with production-derived data defaults to disabled
EXTERNAL_SIDE_EFFECTS_MODE=sandbox

# APP_IMAGE_DIGEST: immutable image digest (required when BACKUP_ROLE=writer)
APP_IMAGE_DIGEST=

# APP_RELEASE_VERSION: application release or Git commit
# APP_RELEASE_VERSION=

# NONPROD_DATA_POLICY: none | sanitized | exact
# NONPROD_DATA_POLICY=
# ---- End Environment Identity ----

# Persistent data contract
DATA_ROOT=/app/data
SQLITE_DB_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/data/media
STATIC_ROOT=/app/data/staticfiles
FAISS_INDEX_DIR=/app/data/faiss_indexes
CHROMA_DIR=/app/data/chroma_db
PDF_CACHE_DIR=/app/data/pdf_cache
BACKUP_DIR=/app/data/backups
DATA_CONTROL_ROOT=/app/data-control
CONTROL_DB_PATH=/app/data-control/control.sqlite3
MAINTENANCE_WORKER_HEARTBEAT_PATH=/app/data-control/runtime/maintenance-worker.heartbeat
MAINTENANCE_WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
MAINTENANCE_WORKER_READINESS_REQUIRED=1
VAULT_RESTORE_ROOT=/app/data/restore-quarantine
RUNTIME_GENERATIONS_ROOT=/app/data/runtime-generations
LEGACY_DATA_ROOT=/mnt/legacy
# Set to 1 only for the controlled first import from prod_flowdocs.
IMPORT_LEGACY_DATA=0
# strict is the default. Use empty/bootstrap only for an explicitly empty first run.
DATA_BOOTSTRAP_MODE=strict
# Optional alternate declared seed paths inside the image or mounted custody.
# DECLARED_SEED_DB=/app/init/db.sqlite3
# DECLARED_SEED_MEDIA=/app/init/media

# OpenAI-backed retrieval
OPENAI_API_KEY=<set-in-dokploy-secret>
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200
MAX_CONTEXT_WORDS=2500
TOP_K_CHUNKS=5
EMBEDDING_TTL=604800
SEARCH_CACHE_TTL=600

# Reserved pass-throughs. The app does not currently use these directly.
GOOGLE_API_KEY=
SENTRY_DSN=

# Redis/cache
# Production Compose pins this to redis://redis:6379/1. Do not set localhost in
# Dokploy; localhost points inside the web container.
REDIS_URL=redis://redis:6379/1

# Public search is enabled for visitors by default. Use an explicit allowlist
# only when a deployment intentionally restricts the public corpus.
PUBLIC_SEARCH_ENABLED=1
# An empty value or `all` includes current and future admin-created folders.
PUBLIC_SEARCH_FOLDER_IDS=
PUBLIC_SEARCH_MAX_WORDS=30
PUBLIC_SEARCH_RATE_LIMIT=30
PUBLIC_SEARCH_RATE_WINDOW=60

# Browser security and cross-origin policy
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Uploads
# Human-readable upload limit. Internally interpreted as MiB-equivalent:
# 1 MB = 1,048,576 bytes. MAX_FILE_SIZE is a deprecated byte-based alias.
MAX_FILE_SIZE_MB=10
# Independent read-only custody limit for canonical legacy media (64 MiB).
# This does not increase the upload or request-body limit above.
ARTIFACT_INVENTORY_MAX_MEDIA_FILE_BYTES=67108864

# Optional email
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=<secret>
# EMAIL_HOST_PASSWORD=<secret>

# Optional immutable artifact vault (RustFS/S3-compatible). Disabled by default.
ARTIFACT_VAULT_ENABLED=0
# ARTIFACT_VAULT_ENDPOINT=https://rustfs.example.invalid
# ARTIFACT_VAULT_BUCKET=flowdocs-artifacts
# ARTIFACT_VAULT_REGION=us-east-1
# ARTIFACT_VAULT_ACCESS_KEY=<set-in-dokploy-secret>
# ARTIFACT_VAULT_SECRET_KEY=<set-in-dokploy-secret>
# Reserved for a future scheduled automation release. Keep disabled; current
# sync and staged-pull actions are explicit superadmin jobs in the UI.
ARTIFACT_VAULT_AUTO_SYNC=0
ARTIFACT_VAULT_AUTO_PULL_ON_EMPTY=0
ARTIFACT_VAULT_BOOTSTRAP_GENERATION=
ARTIFACT_VAULT_RETENTION_COUNT=5
MAINTENANCE_WORKER_POLL_SECONDS=3

# Vault Active Sync control plane. It is off by default. Enabling it also
# enables cooperative mutation tracking; the scheduler still requires
# MAINTENANCE_SCHEDULER_ENABLED=1 and an authoritative production writer.
VAULT_SYNC_ENABLED=0
# disabled | manual | scheduled | continuous_coalesced
VAULT_SYNC_MODE=manual
# publish_only | manual | auto_after_validation
# Production rejects auto_after_validation at startup.
VAULT_SYNC_PROMOTION_MODE=manual
VAULT_SYNC_INTERVAL_SECONDS=900
VAULT_SYNC_QUIET_PERIOD_SECONDS=120
VAULT_SYNC_MAX_LAG_SECONDS=3600
VAULT_SYNC_MAX_PARALLEL_UPLOADS=4
VAULT_SYNC_MAX_PARALLEL_HASHERS=2
VAULT_DEFAULT_PROFILE=production
VAULT_SNAPSHOT_ROOT=/app/data-control/snapshots
VAULT_SNAPSHOT_BARRIER_TIMEOUT_SECONDS=30
VAULT_SNAPSHOT_CLEANUP_GRACE_SECONDS=120
VAULT_SNAPSHOT_CLEANUP_MAX_ITEMS=8
VAULT_SNAPSHOT_CLEANUP_MAX_SCAN_ITEMS=64
VAULT_SNAPSHOT_CLEANUP_MAX_BYTES=536870912
VAULT_SNAPSHOT_CLEANUP_MAX_SECONDS=5
# Candidate-only FAISS derivation safety bounds. No embedding provider is used.
# The per-PDF JSON cap is an input bound, not peak RAM; decoded Python values
# and float64/float32 normalization buffers can overlap transiently.
VAULT_SNAPSHOT_FAISS_MAX_VECTORS=1000000
VAULT_SNAPSHOT_FAISS_MAX_DIMENSIONS=4096
VAULT_SNAPSHOT_FAISS_MAX_BYTES=536870912
VAULT_SNAPSHOT_FAISS_MAX_SOURCE_BYTES=1073741824
VAULT_SNAPSHOT_FAISS_MAX_PDF_JSON_BYTES=134217728
VAULT_SNAPSHOT_FAISS_MAX_PDFS=100000
VAULT_SNAPSHOT_FAISS_MAX_CHUNKS_PER_PDF=100000
VAULT_JOB_HEARTBEAT_SECONDS=15
VAULT_JOB_STALE_SECONDS=90
VAULT_VALIDATION_MAX_AGE_SECONDS=1800
# Multi-source restore stays off until an approved endpoint and server-side
# credential alias are deployed. Secrets never belong in these values.
VAULT_RESTORE_ENABLED=0
VAULT_ADMIN_MUTATIONS_ENABLED=0
# Local index maintenance is independent from Vault publication authority.
LOCAL_INDEX_MAINTENANCE_ENABLED=0
FORCE_REINDEX_ENABLED=0
EXTERNAL_EMBEDDINGS_ENABLED=0
MAINTENANCE_WORKSPACE_ROOT=/app/data-control/maintenance-workspaces
MAINTENANCE_JOB_TIMEOUT_SECONDS=7200
MAINTENANCE_CANDIDATE_PREPARATION_ENABLED=0
# Enable on exactly one authorized staging maintenance worker, never web.
MAINTENANCE_CANDIDATE_WRITER_MODE=0
VAULT_UI_PROFILE_CONFIGURATION_ENABLED=0
VAULT_UI_SECRET_ENTRY_ENABLED=0
VAULT_PROFILE_ENCRYPTION_KEY=
# Exact comma-separated origins, for example https://rustfs.example.gov.in.
VAULT_ALLOWED_S3_ENDPOINTS=
# alias=ENV_PREFIX; the server reads ENV_PREFIX_ACCESS_KEY/SECRET_KEY.
VAULT_CREDENTIAL_ALIASES=
VAULT_BLOCK_PRIVATE_S3_ENDPOINTS=1
VAULT_ALLOW_HTTP_S3_ENDPOINTS=0
VAULT_INVENTORY_CACHE_SECONDS=30
VAULT_MAX_MANIFEST_BYTES=8388608
VAULT_MAX_MANIFEST_OBJECTS=100000
VAULT_MAX_GENERATION_BYTES=536870912000
VAULT_RESTORE_REQUIRE_SANITIZATION=1
# Staging-only, default-deny exception for read-only manifests with explicit
# repacked_from_generation_id provenance. Structural checks and rehearsal still run.
VAULT_RESTORE_ALLOW_REPACKED_RELEASE_MISMATCH=0
VAULT_RESTORE_MIN_FREE_BYTES=0
VAULT_RESTORE_MIN_FREE_INODES=0
# Staging cutover remains off until a signed active pointer, immutable current
# and target runtimes, smoke-query file, and recovery credential are deployed.
# Production rejects this switch even if it is set accidentally.
STAGING_RUNTIME_ACTIVATION_ENABLED=0
STAGING_ACTIVATION_APPLY_MODE=auto
ACTIVATION_INTENT_SIGNING_KEY=
ACTIVATION_SMOKE_QUERIES_FILE=/app/data-control/config/activation-smoke-queries.json
ACTIVATION_RECOVERY_SUPERADMIN_USERNAME=
ACTIVATION_RECOVERY_SUPERADMIN_PASSWORD=
ACTIVATION_SUPERVISOR_POLL_SECONDS=2
ACTIVATION_READINESS_TIMEOUT_SECONDS=120
MAINTENANCE_SCHEDULER_ENABLED=0

# Optional first-run administration. Keep disabled after initialization.
CREATE_SUPERUSER=0
# These are bootstrap inputs only. Rotating them in .env does not change an
# existing database user; use a Django password reset/change flow for that.
# DJANGO_SUPERUSER_USERNAME=<username>
# DJANGO_SUPERUSER_EMAIL=<email>
# DJANGO_SUPERUSER_PASSWORD=<secret>

# Runtime tuning
GUNICORN_WORKERS=4
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_TIMEOUT=300
FIXTURE_BACKUP=0
RUN_JSON_MIGRATIONS=0
PDFSEARCH_IMAGE=<immutable-ghcr-image-or-digest>
# Compose binds this host port to 127.0.0.1; Traefik owns public ingress.
WEB_PORT=8000
