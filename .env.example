# FlowDocs (PdfSearch) — Environment Variables
# Copy this to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── Django ──
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,dev.ai-sahakar.net,one.ai-sahakar.net,www.ai-sahakar.net,ai-sahakar.net,stagetwo.ai-sahakar.net,stagethree.ai-sahakar.net

# ── Database (SQLite default; uncomment for PostgreSQL) ──
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=flowdocs
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=db-host
# DB_PORT=5432

# ── API Keys (REQUIRED for AI search) ──
OPENAI_API_KEY=sk-your-openai-api-key
# GOOGLE_API_KEY=your-google-api-key

# ── Redis ──
REDIS_URL=redis://redis:6379/1

# ── CORS / CSRF (comma-separated origins) ──
CORS_ALLOWED_ORIGINS=https://ai-sahakar.net,https://dev.ai-sahakar.net,https://one.ai-sahakar.net,https://stagetwo.ai-sahakar.net,https://stagethree.ai-sahakar.net
CSRF_TRUSTED_ORIGINS=https://dev.ai-sahakar.net,https://one.ai-sahakar.net,https://mum-01.ai-sahakar.net,http://localhost:8000,http://127.0.0.1:8000,https://ai-sahakar.net,https://www.ai-sahakar.net,https://stagetwo.ai-sahakar.net,https://stagethree.ai-sahakar.net

# ── Auto-Created Superuser ──
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@gmail.com
DJANGO_SUPERUSER_PASSWORD=admin123

# ── File Upload ──
MAX_FILE_SIZE=10485760

# ── Email (optional) ──
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-email-password

# ── Security ──
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ── Monitoring ──
# SENTRY_DSN=https://your-sentry-dsn

# ── Docker / Dokploy ──
APP_UID=1000
APP_GID=1000
WEB_PORT=8000
