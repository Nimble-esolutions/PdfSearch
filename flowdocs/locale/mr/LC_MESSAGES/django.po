msgstr "सक्रिय समक्रमण"

msgid "Artifact cleanup"
msgstr "कलाकृती स्वच्छता"

msgid "Reindex documents"
msgstr "दस्तऐवजांचे पुनःअनुक्रमण करा"

msgid "Validate documents"
msgstr "दस्तऐवजांची पडताळणी करा"

msgid "Repair stored indexes"
msgstr "संग्रहित अनुक्रमणिका दुरुस्त करा"

msgid "Reindex documents that need attention"
msgstr "लक्ष देणे आवश्यक असलेल्या दस्तऐवजांचे पुनःअनुक्रमण करा"

msgid "Reindex selected documents"
msgstr "निवडलेल्या दस्तऐवजांचे पुनःअनुक्रमण करा"

msgid "Prepare maintenance candidate"
msgstr "देखभाल उमेदवार तयार करा"

msgid "Repair document text"
msgstr "दस्तऐवजातील मजकूर दुरुस्त करा"

msgid "Historical profile has no remote Vault connection"
msgstr "ऐतिहासिक रूपरेषेला दूरस्थ व्हॉल्ट जोडणी नाही"

msgid ""
"This record preserves earlier application evidence and is not an S3 "
"connection profile."
msgstr "ही नोंद अनुप्रयोगाचा जुना पुरावा जतन करते; ती S3 जोडणी रूपरेषा नाही."

msgid "Remote probe and inventory controls do not apply to it."
msgstr "दूरस्थ तपासणी आणि सूची नियंत्रणे या नोंदीला लागू होत नाहीत."

msgid "Review the environment Vault profile"
msgstr "पर्यावरण व्हॉल्ट रूपरेषेचा आढावा घ्या"

msgid "Vault profile configuration is incomplete"
msgstr "व्हॉल्ट रूपरेषेची संरचना अपूर्ण आहे"

msgid "The profile is missing server-approved connection information."
msgstr "रूपरेषेत सर्व्हरने मान्य केलेली जोडणी माहिती उपलब्ध नाही."

msgid "Remote probe and inventory controls remain unavailable."
msgstr "दूरस्थ तपासणी आणि सूची नियंत्रणे अनुपलब्ध राहतील."

msgid "Complete profile configuration"
msgstr "रूपरेषेची संरचना पूर्ण करा"

msgid "Vault profile fields need attention"
msgstr "व्हॉल्ट रूपरेषेतील क्षेत्रांकडे लक्ष देणे आवश्यक आहे"

msgid "One or more required profile values are missing or invalid."
msgstr "रूपरेषेतील एक किंवा अधिक आवश्यक मूल्ये उपलब्ध नाहीत किंवा अवैध आहेत."

msgid "No profile change was saved."
msgstr "रूपरेषेतील कोणताही बदल जतन केला नाही."

msgid "Correct the highlighted fields"
msgstr "ठळक केलेली क्षेत्रे दुरुस्त करा"

msgid "Browser profile configuration is disabled"
msgstr "ब्राउझरमधील रूपरेषा संरचना बंद आहे"

msgid ""
"This environment accepts Vault profiles only from deployed configuration."
msgstr "हे पर्यावरण व्हॉल्ट रूपरेषा केवळ तैनात संरचनेतून स्वीकारते."

msgid "No browser-submitted profile can be saved."
msgstr "ब्राउझरमधून सादर केलेली कोणतीही रूपरेषा जतन करता येणार नाही."

msgid "Review deployed Vault configuration"
msgstr "तैनात व्हॉल्ट संरचनेचा आढावा घ्या"

msgid "Vault endpoint is not approved"
msgstr "व्हॉल्ट अंतिमबिंदू मान्य नाही"

msgid "The endpoint does not exactly match a server-approved S3 origin."
msgstr "अंतिमबिंदू सर्व्हरने मान्य केलेल्या S3 उगमाशी तंतोतंत जुळत नाही."

msgid "The profile cannot connect to that endpoint."
msgstr "रूपरेषा त्या अंतिमबिंदूशी जोडली जाऊ शकत नाही."

msgid "Review the endpoint allowlist"
msgstr "अंतिमबिंदू मान्य-सूचीचा आढावा घ्या"

msgid "Vault endpoint needs correction"
msgstr "व्हॉल्ट अंतिमबिंदू दुरुस्त करणे आवश्यक आहे"

msgid ""
"Enter only an HTTP or HTTPS origin without credentials, a path, query, or "
"fragment."
msgstr "प्रवेश-प्रमाण, मार्ग, प्रश्न किंवा तुकडा नसलेला केवळ HTTP किंवा HTTPS उगम प्रविष्ट करा."

msgid "The profile was not saved."
msgstr "रूपरेषा जतन केली नाही."

msgid "Correct the endpoint"
msgstr "अंतिमबिंदू दुरुस्त करा"

msgid "Credential alias is not approved"
msgstr "प्रवेश-प्रमाण पर्यायी नाव मान्य नाही"

msgid "The alias is not mapped to a server-managed credential source."
msgstr "हे पर्यायी नाव सर्व्हर-व्यवस्थापित प्रवेश-प्रमाण स्रोताशी जोडलेले नाही."

msgid "The browser cannot create or use the profile."
msgstr "ब्राउझर ही रूपरेषा तयार करू किंवा वापरू शकत नाही."

msgid "Review approved credential aliases"
msgstr "मान्य प्रवेश-प्रमाण पर्यायी नावांचा आढावा घ्या"

msgid "Approved credentials are unavailable"
msgstr "मान्य प्रवेश-प्रमाण उपलब्ध नाहीत"

msgid ""
"The server-approved alias is present, but its credential variables are "
"incomplete."
msgstr "सर्व्हरने मान्य केलेले पर्यायी नाव आहे; मात्र त्याची प्रवेश-प्रमाण चल अपूर्ण आहेत."

msgid "Remote Vault operations remain unavailable."
msgstr "दूरस्थ व्हॉल्ट कार्ये अनुपलब्ध राहतील."

msgid "Review deployed credentials"
msgstr "तैनात प्रवेश-प्रमाणाचा आढावा घ्या"

msgid "Vault profile evidence changed"
msgstr "व्हॉल्ट रूपरेषेचा पुरावा बदलला आहे"

msgid ""
"The stored profile no longer matches its verified connection fingerprint."
msgstr "जतन केलेली रूपरेषा तिच्या पडताळलेल्या जोडणी ठशाशी आता जुळत नाही."

msgid "Remote operations remain blocked until the profile is reviewed."
msgstr "रूपरेषेचा आढावा होईपर्यंत दूरस्थ कार्ये रोखलेली राहतील."

msgid "No published Vault inventory is available yet"
msgstr "अद्याप कोणतीही प्रकाशित व्हॉल्ट सूची उपलब्ध नाही"

msgid ""
"The bucket is reachable, but it does not contain a readable dataset "
"registration."
msgstr "बकेटशी जोडणी होते; मात्र त्यात वाचता येणारी डेटासेट नोंदणी नाही."

msgid "There is no authoritative remote generation to verify."
msgstr "पडताळण्यासाठी कोणताही अधिकृत दूरस्थ निर्मिती संच नाही."

msgid "Publish the first verified generation"
msgstr "पहिला पडताळलेला निर्मिती संच प्रकाशित करा"

msgid "Vault endpoint could not be approved"
msgstr "व्हॉल्ट अंतिमबिंदू मान्य करता आला नाही"

msgid ""
"The endpoint did not satisfy the deployed transport, DNS, or network safety "
"policy."
msgstr "अंतिमबिंदूने तैनात वाहतूक, DNS किंवा जाळे सुरक्षा धोरण पूर्ण केले नाही."

msgid "The profile was not saved and no connection was attempted."
msgstr "रूपरेषा जतन केली नाही आणि कोणताही जोडणी प्रयत्न केला नाही."

msgid "Review the endpoint and allowlist"
msgstr "अंतिमबिंदू आणि मान्य-सूचीचा आढावा घ्या"

msgid "Vault profile cannot be changed"
msgstr "व्हॉल्ट रूपरेषा बदलता येत नाही"

msgid ""
"The requested profile or credential source is controlled by deployed "
"configuration."
msgstr "विनंती केलेली रूपरेषा किंवा प्रवेश-प्रमाण स्रोत तैनात संरचनेद्वारे नियंत्रित केला जातो."

msgid "No profile change was made."
msgstr "रूपरेषेत कोणताही बदल केला नाही."

msgid "Add another read-only profile"
msgstr "आणखी एक केवळ-वाचन रूपरेषा जोडा"

msgid ""
"Additional profiles are managed by deployed configuration in this "
"environment."
msgstr "या पर्यावरणातील अतिरिक्त रूपरेषा तैनात संरचनेद्वारे व्यवस्थापित केल्या जातात."

msgid "Candidate preparation in progress"
msgstr "उमेदवाराची तयारी सुरू आहे"

msgid "Maintenance job progress"
msgstr "देखभाल कामाची प्रगती"

msgid "Safe document preparation is unavailable"
msgstr "दस्तऐवजांची सुरक्षित तयारी उपलब्ध नाही"

msgid ""
"This environment cannot prove that source documents stay consistent while a "
"maintenance candidate is prepared."
msgstr ""
"देखभाल उमेदवार तयार करताना स्रोत दस्तऐवज सुसंगत राहतात, हे या पर्यावरणात सिद्ध करता "
"येत नाही."

msgid ""
"Repair and reindex work remain disabled; read-only validation is still "
"available."
msgstr "दुरुस्ती आणि पुनःअनुक्रमणाचे काम बंद राहील; केवळ-वाचन पडताळणी अजूनही उपलब्ध आहे."

msgid "Review maintenance safety configuration"
msgstr "देखभाल सुरक्षा संरचना तपासा"

msgid "A candidate can only be prepared from a completed maintenance job."
msgstr "कॅन्डिडेट फक्त पूर्ण झालेल्या देखभाल कार्यातूनच तयार करता येतो."

msgid "A maintenance filter is invalid"
msgstr "देखभालीसाठी वापरलेला फिल्टर अवैध आहे"

msgid "A protected snapshot is in progress"
msgstr "संरक्षित स्नॅपशॉट तयार करण्याचे काम सुरू आहे"

msgid ""
"A short-lived confirmation was issued for the reviewed action and target."
msgstr "पुनरावलोकन केलेल्या कृतीसाठी आणि लक्ष्याकरिता अल्पकालीन पुष्टी जारी केली आहे."

msgid "A valid request key is required"
msgstr "वैध विनंती कळ आवश्यक आहे"

msgid "A worker will prepare and verify an isolated restore workspace."
msgstr "वर्कर स्वतंत्र रिस्टोअर कार्यक्षेत्र तयार करून त्याची पडताळणी करेल."

msgid "A worker will prepare and verify the requested synchronization."
msgstr "वर्कर विनंती केलेले समक्रमण तयार करून त्याची पडताळणी करेल."

msgid "Activation confirmation required"
msgstr "सक्रियकरणासाठी पुष्टी आवश्यक आहे"

msgid "Activation was not scheduled."
msgstr "सक्रियकरण नियोजित केले नाही."

msgid "Authority remains unchanged until the retry succeeds and is verified."
msgstr "पुनर्प्रयत्न यशस्वी होऊन त्याची पडताळणी होईपर्यंत अधिकृत स्थिती बदलणार नाही."

msgid "Browser cleanup execution is unavailable"
msgstr "ब्राउझरमधून साफसफाई चालवणे उपलब्ध नाही"

msgid "Cancellation was requested"
msgstr "रद्द करण्याची विनंती केली आहे"

msgid "Candidate preparation remains unavailable."
msgstr "कॅन्डिडेट तयार करणे अद्याप उपलब्ध नाही."

msgid "Choose a different scope"
msgstr "वेगळी व्याप्ती निवडा"

msgid "Choose a smaller scope"
msgstr "लहान व्याप्ती निवडा"

msgid "Choose an available operation"
msgstr "उपलब्ध कार्यवाही निवडा"

msgid "Cleanup cannot remove it while the hold remains active."
msgstr "जतन स्थगिती सक्रिय असेपर्यंत साफसफाईदरम्यान ते काढता येणार नाही."

msgid "Cleanup inventory is unavailable"
msgstr "साफसफाईची सूची उपलब्ध नाही"

msgid "Cleanup plan is ready"
msgstr "साफसफाईची योजना तयार आहे"

msgid ""
"Cleanup plans can be reviewed here but cannot be executed from this "
"interface."
msgstr ""
"साफसफाईच्या योजनांचे येथे पुनरावलोकन करता येते; मात्र या इंटरफेसमधून त्या चालवता येत नाहीत."

msgid "Cleanup remains unavailable."
msgstr "साफसफाई अद्याप उपलब्ध नाही."

msgid "Complete the confirmed action"
msgstr "पुष्टी केलेली कृती पूर्ण करा"

msgid "Confirmation is ready"
msgstr "पुष्टी तयार आहे"

msgid "Control evidence is unavailable"
msgstr "नियंत्रणाचा पुरावा उपलब्ध नाही"

msgid "Correct the expiry and try again"
msgstr "समाप्तीची वेळ दुरुस्त करून पुन्हा प्रयत्न करा"

msgid "Correct the filters and review again"
msgstr "फिल्टर दुरुस्त करून पुन्हा पुनरावलोकन करा"

msgid "Correct the request and try again"
msgstr "विनंती दुरुस्त करून पुन्हा प्रयत्न करा"

msgid "Duplicate or ambiguous work was not created."
msgstr "दुबार किंवा संदिग्ध काम तयार केले नाही."

msgid ""
"Eligible artifacts and their protection evidence were recorded for review."
msgstr "पात्र आर्टिफॅक्ट आणि त्यांच्या संरक्षणाचे पुरावे पुनरावलोकनासाठी नोंदवले आहेत."

msgid "Enter the confirmation and review again"
msgstr "पुष्टी प्रविष्ट करून पुन्हा पुनरावलोकन करा"

msgid "Fresh Workbench evidence is required"
msgstr "कार्यपटलाचा अद्ययावत पुरावा आवश्यक आहे"

msgid "Generation is available for review again"
msgstr "निर्मिती संच पुन्हा पुनरावलोकनासाठी उपलब्ध आहे"

msgid "Generation is retired"
msgstr "निर्मिती संच निवृत्त केला आहे"

msgid "It is not authoritative unless separately promoted and verified."
msgstr "स्वतंत्रपणे प्रमोट करून पडताळणी केल्याशिवाय तो अधिकृत मानला जाणार नाही."

msgid "Its bounded review window ended before the work was queued."
msgstr "काम रांगेत ठेवण्यापूर्वीच त्याचा मर्यादित पुनरावलोकन कालावधी संपला."

msgid "Its current lifecycle state is not eligible for retirement."
msgstr "त्याची सध्याची जीवनचक्र स्थिती निवृत्तीसाठी पात्र नाही."

msgid "Job cancellation was requested"
msgstr "कार्य रद्द करण्याची विनंती केली आहे"

msgid "Job retry is queued"
msgstr "कार्याचा पुनर्प्रयत्न रांगेत आहे"

msgid "Maintenance candidate is prepared"
msgstr "देखभाल कॅन्डिडेट तयार आहे"

msgid "Maintenance evidence has changed"
msgstr "देखभालीचा पुरावा बदलला आहे"

msgid ""
"Maintenance must wait while the current snapshot or publication work "
"completes."
msgstr "सध्याचे स्नॅपशॉट किंवा प्रकाशनाचे काम पूर्ण होईपर्यंत देखभाल थांबवावी लागेल."

msgid "Maintenance plan is ready"
msgstr "देखभाल योजना तयार आहे"

msgid "Maintenance work is not complete"
msgstr "देखभालीचे काम पूर्ण झालेले नाही"

msgid "Maintenance work is queued"
msgstr "देखभालीचे काम रांगेत आहे"

msgid "Maintenance work is queued again"
msgstr "देखभालीचे काम पुन्हा रांगेत ठेवले आहे"

msgid "Mutation controls are unavailable"
msgstr "बदल नियंत्रणे उपलब्ध नाहीत"

msgid "No additional request was accepted."
msgstr "अतिरिक्त विनंती स्वीकारली नाही."

msgid "No artifacts were deleted."
msgstr "कोणतेही आर्टिफॅक्ट हटवले नाहीत."

msgid "No document data has changed yet."
msgstr "दस्तऐवजांचा कोणताही डेटा अद्याप बदललेला नाही."

msgid "No documents match this maintenance scope"
msgstr "या देखभाल व्याप्तीशी कोणतेही दस्तऐवज जुळत नाहीत"

msgid "No maintenance change was accepted."
msgstr "देखभालीतील कोणताही बदल स्वीकारला नाही."

msgid "No maintenance plan was created."
msgstr "देखभाल योजना तयार केली नाही."

msgid "No maintenance work was created."
msgstr "देखभालीचे काम तयार केले नाही."

msgid "No maintenance work was queued."
msgstr "देखभालीचे कोणतेही काम रांगेत ठेवले नाही."

msgid "No mutation request was accepted."
msgstr "बदलाची कोणतीही विनंती स्वीकारली नाही."

msgid "No new candidate or publication job was created."
msgstr "नवीन कॅन्डिडेट किंवा प्रकाशन कार्य तयार केले नाही."

msgid "No operational change was made."
msgstr "कार्यप्रणालीत कोणताही बदल केला नाही."

msgid "No retention hold was created."
msgstr "जतन स्थगिती तयार केली नाही."

msgid "No source changes need synchronization"
msgstr "स्रोतामधील कोणत्याही बदलांचे समक्रमण आवश्यक नाही"

msgid "Nothing has been deleted."
msgstr "काहीही हटवलेले नाही."

msgid "One or more filter values could not be interpreted safely."
msgstr "एक किंवा अधिक फिल्टर मूल्यांचा सुरक्षितपणे अर्थ लावता आला नाही."

msgid "Only a retired generation can be returned to candidate review."
msgstr "फक्त निवृत्त निर्मिती संचच कॅन्डिडेट पुनरावलोकनासाठी परत आणता येतो."

msgid "Only a verified candidate generation can be promoted."
msgstr "फक्त पडताळलेला कॅन्डिडेट निर्मिती संचच प्रमोट करता येतो."

msgid "Only the operator who prepared the plan can queue it."
msgstr "योजना तयार करणारा परिचालकच ती रांगेत ठेवू शकतो."

msgid "Other protections may still prevent cleanup."
msgstr "इतर संरक्षणांमुळे साफसफाई अजूनही रोखली जाऊ शकते."

msgid "Prepare a new maintenance plan"
msgstr "नवीन देखभाल योजना तयार करा"

