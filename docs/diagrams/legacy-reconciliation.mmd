flowchart LR
    legacy["Legacy source\nread-only custody"] --> compare["Inventory rows, media, indexes, and hashes"]
    target["Target instance\nseparate custody boundary"] --> compare
    compare --> overlap["Classify matching and conflicting paths"]
    compare --> divergence["Classify database and schema divergence"]
    overlap --> import["DataOps foreign-source import / rebind"]
    divergence --> import
    import --> stage["Isolated restore candidate"]
    stage --> validate["FAISS fingerprints and search"]
    validate --> promote["Explicit promotion only"]
    direct["Direct copy or silent merge"] -. "prohibited" .-> stage
