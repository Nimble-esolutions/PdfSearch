flowchart TD
    local["Owned dataset"] --> plan["Deterministic DataOps v3 plan"]
    foreign["Foreign dataset"] --> plan
    plan --> route{"Dataset ownership"}
    route -- "same" --> restore["Restore selected immutable recovery point"]
    route -- "foreign" --> rebind["Import/rebind with parent lineage"]
    restore --> quarantine["Unique restore-quarantine candidate"]
    rebind --> quarantine
    quarantine --> verify["Object digests · SQLite · migrations · media · indexes"]
    verify --> search["Representative search and readiness evidence"]
    search --> decision{"Signed staging activation approved?"}
    decision -- "no" --> retain["Retain candidate and evidence"]
    decision -- "yes" --> intent["Signed exact generation + manifest intent"]
    intent --> pointer["Compare-and-swap runtime pointer"]
    pointer --> ready{"Exact readiness passes?"}
    ready -- "yes" --> receipt["Signed result; previous pointer retained"]
    ready -- "no" --> rollback["Automatic previous-pointer rollback"]
    direct["Direct copy, silent merge, or active target"] -. "prohibited" .-> pointer
