flowchart TD
    pdf["Uploaded or quarantined PDF"] --> job["Durable processing job"]
    job --> worker["Maintenance worker<br/>same application image"]

    subgraph core["Document intelligence — flowdocs/core"]
        worker --> native["Native text extraction per page"]
        native --> usable{"Usable native text?"}
        usable -->|Yes| aggregate["Aggregate extracted text + provenance"]
        usable -->|Blank/image-only page| bounds{"Local OCR bounds pass?<br/>page · pixel · time · language"}
        bounds -->|No| failed["Fail closed<br/>do not mark searchable"]
        bounds -->|Yes| render["Render only required page locally"]
        render --> tesseract["Local Tesseract<br/>eng + mar + hin"]
        tesseract --> aggregate
        aggregate --> chunks["Bounded chunking"]
        chunks --> embedding["Configured embedding provider<br/>extracted text only"]
        embedding --> dimension{"Embedding dimension matches contract?"}
        dimension -->|No| failed
        dimension -->|Yes| indexes["Generation/candidate-scoped<br/>FAISS and optional Chroma artifacts"]
    end

    pdf -.-> custody["Original PDF bytes stay local<br/>only extracted text follows embedding policy"]
    indexes --> verify["Digest · database/media reconciliation<br/>index load · representative search"]
    verify --> context{"Processing context"}
    context -->|Active local mutation| ready["processing_status=ready<br/>indexed=true"]
    context -->|Restore/import candidate| activation["Signed activation intent"]
    activation --> cas["CAS runtime pointer<br/>preserve previous pointer"]
    cas --> readiness{"Exact readiness passes?"}
    readiness -->|Yes| ready
    readiness -->|No| rollback["Previous-pointer rollback"]

    indexes -. "reuse only when compatible;<br/>otherwise rebuild in quarantine" .-> verify
