flowchart TD
    incident["Incident or readiness failure"] --> contain["Contain writes and preserve evidence<br/>logs · image digest · volume IDs · pointer documents"]
    contain --> classify{"Failure boundary"}

    classify -->|Image/runtime only| image_pair["Select verified previous<br/>image-generation pair"]
    classify -->|Data/index/unknown| point["Select exact immutable<br/>DataOps v3 recovery point"]

    point --> isolate["Restore to disposable data/control roots<br/>never active or legacy volumes"]
    isolate --> verify["Manifest/object digests<br/>SQLite integrity/FK/migrations<br/>media/index reconciliation"]
    verify --> behavior["Representative multilingual search<br/>source-link · PDF · readiness proof"]
    behavior --> approved{"Recovery approved?"}
    approved -->|No| retain["Retain failed target and evidence<br/>active pointer unchanged"]
    approved -->|Yes| image_pair

    image_pair --> intent["Signed recovery/activation intent<br/>exact image + generation + manifest"]
    intent --> coordinate["Web + maintenance acknowledgements"]
    coordinate --> cas["CAS active pointer<br/>retain previous pointer"]
    cas --> readiness{"/livez and exact /readyz pass?"}
    readiness -->|Yes| receipt["Signed result + incident recovery receipt"]
    readiness -->|No| rollback["CAS previous pointer back<br/>signed rollback result"]
    rollback --> retain

    receipt --> traffic{"Separate traffic decision required?"}
    traffic -->|Stage| observe["Observe stage; legacy production unchanged"]
    traffic -->|Future production| cutover["Independent security, data, DNS/TLS<br/>and rollback approval"]
