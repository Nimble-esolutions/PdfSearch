flowchart TD
    incident["Incident detected"] --> evidence["Preserve logs, digests, volumes, checksums"]
    evidence --> record["Create control-plane recovery record"]
    record --> isolate["Isolate paired disposable data/control target"]
    isolate --> integrity["SQLite integrity and migration checks"]
    integrity --> counts["PDF count and FAISS count"]
    counts --> indexes["FAISS fingerprint and load validation"]
    indexes --> search["Representative search"]
    search --> intent["Signed intent binds exact generation + manifest"]
    intent --> coordinate["Coordinate web + maintenance; CAS pointer"]
    coordinate --> endpoints["/livez and exact /readyz proof"]
    endpoints --> decision{"Restore passes?"}
    decision -- "no" --> retain["Retain failed target; do not promote"]
    decision -- "yes" --> receipt["Signed activation result + recovery receipt"]
    decision -- "runtime failure" --> rollback["Restore previous pointer; sign rollback result"]
    receipt --> approve["Explicit traffic decision, if separately authorized"]
