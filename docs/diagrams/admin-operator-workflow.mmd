        search_ready -->|Ready| public["Classic / Workbench public search"]
        search_ready -->|Needs attention| maintenance["Preview validation / repair / reindex"]
        maintenance --> queue
    end

    subgraph protection["Data protection — DataOps v3"]
        actions["Back up · Restore · Import · Test recovery"] --> preview["Read-only deterministic preview"]
        preview --> confirmed["Plan-bound confirmation when required"]
        confirmed --> operation["Resumable operation + redacted audit evidence"]
        operation --> candidate["Immutable recovery point or isolated candidate"]
        candidate --> activation["Separate signed stage activation"]
    end

    cockpit --> folders
    cockpit --> maintenance
    cockpit --> actions
    cockpit --> users["Users and public-theme settings"]
    operation --> readiness["Shared DataOps readiness projection"]
    readiness --> cockpit
    readiness --> readyz["/readyz"]

