# Reviewed 2026-08-06. Non-production stage reference.
# This populated stage serves a signed runtime. Restore candidates still enter
# quarantine and do not replace the active pointer until signed activation.

APP_ENV=staging
DEPLOYMENT_ID=stage-2026-ai-sahakar
DATASET_ID=ai-sahakar-stage-2026
AUTHORITATIVE_DATASET_ID=ai-sahakar-stage-2026
PRODUCTION_SOURCE_ID=ai-sahakar-prod-v2
DATA_MODE=local
BACKUP_ROLE=reader
BACKUP_SYNC_MODE=manual
MAINTENANCE_SCHEDULER_ENABLED=0
RESTORE_SOURCE_DATASET_ID=ai-sahakar-stage-2026
RESTORE_POLICY=manual
# Keep non-AI side effects (email/webhooks/payments) sandboxed.  The explicit
# AI-only mode makes stage search/chat use the configured OpenAI provider.
EXTERNAL_SIDE_EFFECTS_MODE=sandbox
EXTERNAL_AI_MODE=enabled
NONPROD_DATA_POLICY=exact
EXACT_PRODUCTION_DATA_APPROVED=1
EXACT_PRODUCTION_DATA_APPROVAL_ID=<security-approval-reference>

# Operator-approved stage policy: follow the latest channel and always pull.
# Record `docker inspect`'s resolved image digest after every deployment.
# Production uses an immutable repo@sha256 digest instead.
PDFSEARCH_IMAGE=ghcr.io/nimble-esolutions/pdfsearch/shakar-frontend:latest
# Compose passes PDFSEARCH_IMAGE into the container as APP_IMAGE_DIGEST.
# Record the resolved repo@sha256 digest separately from docker inspect.
APP_RELEASE_VERSION=stage-latest

DEBUG=False
ALLOW_INSECURE_DEFAULTS=0
SECRET_KEY=<stage-secret>
OPENAI_API_KEY=<stage-secret-or-approved-test-key>
ALLOWED_HOSTS=2026.ai-sahakar.net,cdev.ai-sahakar.net
CSRF_TRUSTED_ORIGINS=https://2026.ai-sahakar.net,https://cdev.ai-sahakar.net
CORS_ALLOWED_ORIGINS=https://2026.ai-sahakar.net,https://cdev.ai-sahakar.net
DJANGO_SETTINGS_MODULE=flowdocs.settings

REDIS_URL=redis://redis:6379/1
# Runtime controls are UI-editable when absent. Uncomment only to create an
# intentional deployment-owned override; the corresponding UI field will lock.
# PUBLIC_SEARCH_ENABLED=1
# DISPLAY_SERVICE_FOOTER=1
# PUBLIC_SEARCH_PRIMARY_VIEW=classic
# PUBLIC_SEARCH_MAX_WORDS=30
# PUBLIC_SEARCH_RATE_LIMIT=30
# PUBLIC_SEARCH_RATE_WINDOW=60
# PRODUCT_ANALYTICS_MODE=enabled
# PRODUCT_ANALYTICS_WEBSITE_ID=<stage-public-umami-website-uuid>
STAGE_PUBLIC_AUTH_EXCEPTION_REQUIRED=1
STAGE_PUBLIC_AUTH_EXCEPTION_APPROVED=1
STAGE_PUBLIC_AUTH_EXCEPTION_OWNER=<security-owner-reference>
STAGE_PUBLIC_AUTH_EXCEPTION_MONITORING=<monitoring-reference>
STAGE_PUBLIC_AUTH_EXCEPTION_INCIDENT_RESPONSE=<incident-response-reference>
STAGE_PUBLIC_AUTH_EXCEPTION_ROLLBACK_AUTHORITY=<rollback-authority-reference>
PUBLIC_SEARCH_FOLDER_IDS=

OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200
PDF_OCR_FALLBACK_ENABLED=1
PDF_OCR_BINARY=tesseract
PDF_OCR_LANGUAGES=eng+mar+hin
PDF_OCR_DPI=200
PDF_OCR_MAX_PAGES=50
PDF_OCR_PAGE_TIMEOUT_SECONDS=180
PDF_OCR_MAX_SECONDS=900
PDF_OCR_MAX_PIXELS=25000000
MAX_CONTEXT_WORDS=2500
TOP_K_CHUNKS=5
EMBEDDING_TTL=604800
SEARCH_CACHE_TTL=600
MAX_FILE_SIZE_MB=10
ARTIFACT_INVENTORY_MAX_MEDIA_FILE_BYTES=67108864

DATA_ROOT=/app/data
SQLITE_DB_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/data/media
STATIC_ROOT=/app/data/staticfiles
FAISS_INDEX_DIR=/app/data/faiss_indexes
CHROMA_DIR=/app/data/chroma_db
BACKUP_DIR=/app/data/backups
DATA_BOOTSTRAP_MODE=strict
IMPORT_LEGACY_DATA=0
# DataOps v3 owns one stage recovery connection. This block bootstraps it only
# when no stored connection exists. The foreign production-v2 source is added
# as a separate read-only connection for explicit import; it is not a restore
# profile selector.
ARTIFACT_VAULT_ENABLED=1
ARTIFACT_VAULT_ENDPOINT=https://rustfs.example.invalid
ARTIFACT_VAULT_BUCKET=ai-sahakar-stage-2026-flowdocs-artifact-vault
ARTIFACT_VAULT_REGION=us-east-1
ARTIFACT_VAULT_ACCESS_KEY=<stage-scoped-secret>
ARTIFACT_VAULT_SECRET_KEY=<stage-scoped-secret>
DATAOPS_ENABLED=1
DATAOPS_PROFILE_MANIFEST=
DATAOPS_BACKUP_PROFILE=
DATAOPS_RESTORE_PROFILE=
VAULT_SYNC_ENABLED=0
VAULT_RESTORE_ENABLED=0
VAULT_ADMIN_MUTATIONS_ENABLED=0
STAGING_INITIAL_ACTIVATION_ENABLED=1
STAGING_RUNTIME_ACTIVATION_ENABLED=1
STAGING_ACTIVATION_APPLY_MODE=auto
MAINTENANCE_CANDIDATE_PREPARATION_ENABLED=0
MAINTENANCE_CANDIDATE_WRITER_MODE=0
# The scoped ARTIFACT_VAULT credential pair is injected by the approved secret
# provider only after bucket permissions are tested.

CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CREATE_SUPERUSER=0
GUNICORN_WORKERS=2
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=25
GUNICORN_TIMEOUT=300

# For an isolated stage restore, set RESTORE_SOURCE_DATASET_ID, configure the
# vault for the process running the controlled restore, and keep
# BACKUP_ROLE=disabled/reader. DATA_MODE=s3-restore validates the intended
# posture but does not currently pull data at entrypoint startup.
