# Reviewed 2026-07-25. Non-production stage reference.
# This assumes a stage dataset is already present in the stage volume.

APP_ENV=staging
DEPLOYMENT_ID=stage-2026-ai-sahakar
DATASET_ID=ai-sahakar-stage
AUTHORITATIVE_DATASET_ID=ai-sahakar-prod
PRODUCTION_SOURCE_ID=stage-2026
DATA_MODE=local
BACKUP_ROLE=reader
BACKUP_SYNC_MODE=manual
MAINTENANCE_SCHEDULER_ENABLED=0
RESTORE_SOURCE_DATASET_ID=ai-sahakar-prod
RESTORE_POLICY=manual
# Keep non-AI side effects (email/webhooks/payments) sandboxed.  The explicit
# AI-only mode makes stage search/chat use the configured OpenAI provider.
EXTERNAL_SIDE_EFFECTS_MODE=sandbox
EXTERNAL_AI_MODE=enabled
NONPROD_DATA_POLICY=sanitized

# Application Compose pulls this digest; RustFS is operated externally.
PDFSEARCH_IMAGE=ghcr.io/nimble-esolutions/pdfsearch/shakar-frontend@sha256:<immutable-digest>
APP_IMAGE_DIGEST=ghcr.io/nimble-esolutions/pdfsearch/shakar-frontend@sha256:<immutable-digest>
APP_RELEASE_VERSION=<approved-git-sha>

DEBUG=False
ALLOW_INSECURE_DEFAULTS=0
SECRET_KEY=<stage-secret>
OPENAI_API_KEY=<stage-secret-or-approved-test-key>
ALLOWED_HOSTS=2026.ai-sahakar.net,cdev.ai-sahakar.net
CSRF_TRUSTED_ORIGINS=https://2026.ai-sahakar.net,https://cdev.ai-sahakar.net
CORS_ALLOWED_ORIGINS=https://2026.ai-sahakar.net,https://cdev.ai-sahakar.net
DJANGO_SETTINGS_MODULE=flowdocs.settings

REDIS_URL=redis://redis:6379/1
PUBLIC_SEARCH_ENABLED=1
DISPLAY_SERVICE_FOOTER=1
PUBLIC_SEARCH_FOLDER_IDS=
PUBLIC_SEARCH_MAX_WORDS=30
PUBLIC_SEARCH_RATE_LIMIT=30
PUBLIC_SEARCH_RATE_WINDOW=60

OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200
MAX_CONTEXT_WORDS=2500
TOP_K_CHUNKS=5
EMBEDDING_TTL=604800
SEARCH_CACHE_TTL=600
MAX_FILE_SIZE_MB=10
ARTIFACT_INVENTORY_MAX_MEDIA_FILE_BYTES=67108864

DATA_ROOT=/app/data
SQLITE_DB_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/data/media
STATIC_ROOT=/app/data/staticfiles
FAISS_INDEX_DIR=/app/data/faiss_indexes
CHROMA_DIR=/app/data/chroma_db
BACKUP_DIR=/app/data/backups
DATA_BOOTSTRAP_MODE=strict
IMPORT_LEGACY_DATA=0
ARTIFACT_VAULT_ENABLED=1
ARTIFACT_VAULT_ENDPOINT=https://approved-vault.example
ARTIFACT_VAULT_BUCKET=ai-sahakar-prod-flowdocs-artifact-vault
ARTIFACT_VAULT_REGION=local
ARTIFACT_VAULT_ACCESS_KEY=<stage-readonly-access-key>
ARTIFACT_VAULT_SECRET_KEY=<stage-readonly-secret-key>

CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CREATE_SUPERUSER=0
GUNICORN_WORKERS=2
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=25
GUNICORN_TIMEOUT=300

# For an isolated stage restore, set RESTORE_SOURCE_DATASET_ID, configure the
# vault for the process running the controlled restore, and keep
# BACKUP_ROLE=disabled/reader. DATA_MODE=s3-restore validates the intended
# posture but does not currently pull data at entrypoint startup.
