# Reviewed 2026-08-06. Future production Dokploy reference only.
# Replace every <...> value through protected Dokploy configuration.
# Verify the three identity placeholders from the running legacy production
# service. Do not copy the stage dataset or the v2 migration-source identity
# into production without a separately approved production change.

APP_ENV=production
DEPLOYMENT_ID=prod-mum-01
DATASET_ID=<authoritative-production-dataset-id>
AUTHORITATIVE_DATASET_ID=<authoritative-production-dataset-id>
PRODUCTION_SOURCE_ID=<authoritative-production-source-id>
DATA_MODE=local
BACKUP_ROLE=disabled
BACKUP_SYNC_MODE=manual
MAINTENANCE_SCHEDULER_ENABLED=0
RESTORE_POLICY=disabled
RESTORE_SOURCE_DATASET_ID=
DATA_PINNED_GENERATION=
EXTERNAL_SIDE_EFFECTS_MODE=enabled
EXTERNAL_AI_MODE=enabled
NONPROD_DATA_POLICY=

# Application Compose pulls this digest. DataOps v3 remains disabled until the
# future production project and its owned recovery connection are certified.
PDFSEARCH_IMAGE=ghcr.io/nimble-esolutions/pdfsearch/shakar-frontend@sha256:<immutable-digest>
# Compose passes PDFSEARCH_IMAGE into the container as APP_IMAGE_DIGEST.
APP_RELEASE_VERSION=<approved-git-sha>

DEBUG=False
ALLOW_INSECURE_DEFAULTS=0
SECRET_KEY=<dokploy-secret>
OPENAI_API_KEY=<dokploy-secret>
ALLOWED_HOSTS=ai-sahakar.net,www.ai-sahakar.net
CSRF_TRUSTED_ORIGINS=https://ai-sahakar.net,https://www.ai-sahakar.net
CORS_ALLOWED_ORIGINS=https://ai-sahakar.net,https://www.ai-sahakar.net
DJANGO_SETTINGS_MODULE=flowdocs.settings

REDIS_URL=redis://redis:6379/1
PUBLIC_SEARCH_ENABLED=1
DISPLAY_SERVICE_FOOTER=1
PUBLIC_SEARCH_FOLDER_IDS=
PUBLIC_SEARCH_MAX_WORDS=30
PUBLIC_SEARCH_RATE_LIMIT=30
PUBLIC_SEARCH_RATE_WINDOW=60

OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200
PDF_OCR_FALLBACK_ENABLED=1
PDF_OCR_BINARY=tesseract
PDF_OCR_LANGUAGES=eng+mar+hin
PDF_OCR_DPI=200
PDF_OCR_MAX_PAGES=50
PDF_OCR_PAGE_TIMEOUT_SECONDS=180
PDF_OCR_MAX_SECONDS=900
PDF_OCR_MAX_PIXELS=25000000
MAX_CONTEXT_WORDS=2500
TOP_K_CHUNKS=5
EMBEDDING_TTL=604800
SEARCH_CACHE_TTL=600
MAX_FILE_SIZE_MB=10
ARTIFACT_INVENTORY_MAX_MEDIA_FILE_BYTES=67108864

DATA_ROOT=/app/data
SQLITE_DB_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/data/media
STATIC_ROOT=/app/data/staticfiles
FAISS_INDEX_DIR=/app/data/faiss_indexes
CHROMA_DIR=/app/data/chroma_db
BACKUP_DIR=/app/data/backups
LEGACY_DATA_ROOT=/mnt/legacy
IMPORT_LEGACY_DATA=0
DATA_BOOTSTRAP_MODE=strict

# DataOps v3 uses one connection owned by the production dataset. Fill and
# enable this block only after the future project, bucket, scoped credentials,
# conditional writes, and recovery drill are approved.
DATAOPS_ENABLED=0
ARTIFACT_VAULT_ENABLED=0
ARTIFACT_VAULT_ENDPOINT=<owned-production-rustfs-origin>
ARTIFACT_VAULT_BUCKET=<owned-production-recovery-bucket>
ARTIFACT_VAULT_REGION=us-east-1
ARTIFACT_VAULT_ACCESS_KEY=<dokploy-secret>
ARTIFACT_VAULT_SECRET_KEY=<dokploy-secret>
DATAOPS_PROFILE_MANIFEST=
DATAOPS_BACKUP_PROFILE=
DATAOPS_RESTORE_PROFILE=

# Legacy VaultOps publication/restore stays disabled. Its remaining settings
# are implementation compatibility, not a second production configuration.
VAULT_SYNC_ENABLED=0
VAULT_RESTORE_ENABLED=0
VAULT_ADMIN_MUTATIONS_ENABLED=0
VAULT_UI_PROFILE_CONFIGURATION_ENABLED=0
VAULT_UI_SECRET_ENTRY_ENABLED=0

LOCAL_INDEX_MAINTENANCE_ENABLED=0
FORCE_REINDEX_ENABLED=0
EXTERNAL_EMBEDDINGS_ENABLED=0
MAINTENANCE_JOB_TIMEOUT_SECONDS=7200
MAINTENANCE_WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
MAINTENANCE_WORKER_READINESS_REQUIRED=1
MAINTENANCE_CANDIDATE_PREPARATION_ENABLED=0
MAINTENANCE_CANDIDATE_WRITER_MODE=0
STAGING_RUNTIME_ACTIVATION_ENABLED=0
STAGING_INITIAL_ACTIVATION_ENABLED=0
STAGING_ACTIVATION_APPLY_MODE=pending
ACTIVATION_INTENT_SIGNING_KEY=<dokploy-secret>
ACTIVATION_SMOKE_QUERIES_FILE=/app/data-control/config/activation-smoke-queries.json
ACTIVATION_RECOVERY_SUPERADMIN_USERNAME=
ACTIVATION_RECOVERY_SUPERADMIN_PASSWORD=
ACTIVATION_SUPERVISOR_POLL_SECONDS=2
ACTIVATION_READINESS_TIMEOUT_SECONDS=120

# The web and maintenance services must receive the same lifecycle posture,
# release identity, and approved aliases. Verify effective Compose keys and
# posture without printing credential or signing-key values.

CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CREATE_SUPERUSER=0
GUNICORN_WORKERS=4
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_TIMEOUT=300
