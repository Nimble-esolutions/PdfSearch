# Reviewed 2026-07-25. Production Dokploy reference only.
# Replace every <...> value through protected Dokploy configuration.

APP_ENV=production
DEPLOYMENT_ID=prod-mum-01
DATASET_ID=ai-sahakar-prod
AUTHORITATIVE_DATASET_ID=ai-sahakar-prod
PRODUCTION_SOURCE_ID=mum-01
DATA_MODE=local
BACKUP_ROLE=writer
BACKUP_SYNC_MODE=manual
MAINTENANCE_SCHEDULER_ENABLED=0
RESTORE_POLICY=disabled
EXTERNAL_SIDE_EFFECTS_MODE=enabled
NONPROD_DATA_POLICY=

PDFSEARCH_IMAGE=ghcr.io/nimble-esolutions/pdfsearch/shakar-frontend@sha256:<immutable-digest>
APP_IMAGE_DIGEST=ghcr.io/nimble-esolutions/pdfsearch/shakar-frontend@sha256:<immutable-digest>
APP_RELEASE_VERSION=<approved-git-sha>

DEBUG=False
ALLOW_INSECURE_DEFAULTS=0
SECRET_KEY=<dokploy-secret>
OPENAI_API_KEY=<dokploy-secret>
ALLOWED_HOSTS=ai-sahakar.net,www.ai-sahakar.net
CSRF_TRUSTED_ORIGINS=https://ai-sahakar.net,https://www.ai-sahakar.net
CORS_ALLOWED_ORIGINS=https://ai-sahakar.net,https://www.ai-sahakar.net
DJANGO_SETTINGS_MODULE=flowdocs.settings

REDIS_URL=redis://redis:6379/1
PUBLIC_SEARCH_ENABLED=1
DISPLAY_SERVICE_FOOTER=1
PUBLIC_SEARCH_FOLDER_IDS=
PUBLIC_SEARCH_MAX_WORDS=30
PUBLIC_SEARCH_RATE_LIMIT=30
PUBLIC_SEARCH_RATE_WINDOW=60

OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200
MAX_CONTEXT_WORDS=2500
TOP_K_CHUNKS=5
EMBEDDING_TTL=604800
SEARCH_CACHE_TTL=600
MAX_FILE_SIZE_MB=10

DATA_ROOT=/app/data
SQLITE_DB_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/data/media
STATIC_ROOT=/app/data/staticfiles
FAISS_INDEX_DIR=/app/data/faiss_indexes
CHROMA_DIR=/app/data/chroma_db
BACKUP_DIR=/app/data/backups
LEGACY_DATA_ROOT=/mnt/legacy
IMPORT_LEGACY_DATA=0
DATA_BOOTSTRAP_MODE=strict

ARTIFACT_VAULT_ENABLED=1
ARTIFACT_VAULT_ENDPOINT=<rustfs-endpoint>
ARTIFACT_VAULT_BUCKET=ai-sahakar-prod-flowdocs-data-volume
ARTIFACT_VAULT_REGION=us-east-1
ARTIFACT_VAULT_ACCESS_KEY=<dokploy-secret>
ARTIFACT_VAULT_SECRET_KEY=<dokploy-secret>

# The maintenance service must receive the vault, writer identity, sync mode,
# APP_IMAGE_DIGEST, and APP_RELEASE_VERSION. Verify effective Compose service
# environment by key/posture without printing secret values.

CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CREATE_SUPERUSER=0
GUNICORN_WORKERS=4
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_TIMEOUT=300
