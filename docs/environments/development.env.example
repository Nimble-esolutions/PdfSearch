# Reviewed 2026-07-25. Local Docker development reference.
# The repository root .env.example is the copy command target.

APP_ENV=development
DEPLOYMENT_ID=local-dev
DATASET_ID=ai-sahakar-dev
AUTHORITATIVE_DATASET_ID=ai-sahakar-dev
PRODUCTION_SOURCE_ID=local-dev
DATA_MODE=empty
BACKUP_ROLE=disabled
BACKUP_SYNC_MODE=manual
EXTERNAL_SIDE_EFFECTS_MODE=sandbox

DEBUG=True
ALLOW_INSECURE_DEFAULTS=1
SECRET_KEY=django-insecure-local-only-change-me
OPENAI_API_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=flowdocs.settings

REDIS_URL=redis://redis:6379/1
PUBLIC_SEARCH_ENABLED=1
DISPLAY_SERVICE_FOOTER=1
PUBLIC_SEARCH_FOLDER_IDS=
PUBLIC_SEARCH_MAX_WORDS=30
PUBLIC_SEARCH_RATE_LIMIT=30
PUBLIC_SEARCH_RATE_WINDOW=60

OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200
MAX_CONTEXT_WORDS=2500
TOP_K_CHUNKS=5
EMBEDDING_TTL=604800
SEARCH_CACHE_TTL=600
MAX_FILE_SIZE_MB=10

DATA_ROOT=/app/data
SQLITE_DB_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/data/media
STATIC_ROOT=/app/data/staticfiles
FAISS_INDEX_DIR=/app/data/faiss_indexes
CHROMA_DIR=/app/data/chroma_db
BACKUP_DIR=/app/data/backups
DATA_BOOTSTRAP_MODE=empty
CREATE_SUPERUSER=0
ARTIFACT_VAULT_ENABLED=0

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Use PDFSEARCH_TEST_EMBEDDINGS=1 only in disposable CI/test runs. It is not a
# substitute for OpenAI-backed retrieval in stage or production.
PDFSEARCH_TEST_EMBEDDINGS=0
GUNICORN_WORKERS=1
GUNICORN_MAX_REQUESTS=100
GUNICORN_MAX_REQUESTS_JITTER=0
GUNICORN_TIMEOUT=300
