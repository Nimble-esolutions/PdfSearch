# Minimal Environment Variables for FlowDocs
# Copy relevant values to .env (gitignored).
# This file is a reference only — never commit real secrets here.

# Essential Django Settings
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=ai-sahakar.net,www.ai-sahakar.net,one.ai-sahakar.net

# Database (SQLite default for single-node)
# For PostgreSQL, set DB_ENGINE, DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT

# AI API Key (Required for search)
OPENAI_API_KEY=sk-your-openai-api-key

# CSRF (comma-separated)
CSRF_TRUSTED_ORIGINS=https://ai-sahakar.net,https://www.ai-sahakar.net,https://one.ai-sahakar.net
