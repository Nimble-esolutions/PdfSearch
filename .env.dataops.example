# Data Operations — canonical Dokploy environment contract
# ENV is authoritative. Values entered in the UI are database fallbacks only.
# Keep credentials in Dokploy secrets; this file intentionally contains none.

DATAOPS_ENABLED=1
DATAOPS_ENV_PROFILES=production_vault,stage_restore

# Production profile: backup source. Set ROLE=backup or both as required.
DATAOPS_PROFILE_PRODUCTION_VAULT_DISPLAY_NAME=Production recovery bucket
DATAOPS_PROFILE_PRODUCTION_VAULT_ROLE=backup
DATAOPS_PROFILE_PRODUCTION_VAULT_ENDPOINT=https://s3.example.invalid
DATAOPS_PROFILE_PRODUCTION_VAULT_BUCKET=ai-sahakar-prod-flowdocs-artifact-vault
DATAOPS_PROFILE_PRODUCTION_VAULT_REGION=us-east-1
DATAOPS_PROFILE_PRODUCTION_VAULT_DATASET_ID=flowdocs-prod
DATAOPS_PROFILE_PRODUCTION_VAULT_SOURCE_ID=prod
DATAOPS_PROFILE_PRODUCTION_VAULT_CREDENTIAL_PREFIX=DATAOPS_PROD

# Stage profile: restore target. Use an isolated bucket when policy requires it.
DATAOPS_PROFILE_STAGE_RESTORE_DISPLAY_NAME=Stage restore bucket
DATAOPS_PROFILE_STAGE_RESTORE_ROLE=restore
DATAOPS_PROFILE_STAGE_RESTORE_ENDPOINT=https://s3.example.invalid
DATAOPS_PROFILE_STAGE_RESTORE_BUCKET=ai-sahakar-stage-flowdocs-artifact-vault
DATAOPS_PROFILE_STAGE_RESTORE_REGION=us-east-1
DATAOPS_PROFILE_STAGE_RESTORE_DATASET_ID=flowdocs-stage
DATAOPS_PROFILE_STAGE_RESTORE_SOURCE_ID=stage
DATAOPS_PROFILE_STAGE_RESTORE_CREDENTIAL_PREFIX=DATAOPS_STAGE

DATAOPS_BACKUP_PROFILE=production_vault
DATAOPS_RESTORE_PROFILE=stage_restore
DATAOPS_BACKUP_MODE=scheduled
DATAOPS_BACKUP_INTERVAL_SECONDS=900
DATAOPS_BACKUP_QUIET_PERIOD_SECONDS=120
DATAOPS_BACKUP_MAX_LAG_SECONDS=3600

# Safe automatic recovery. Restore and production activation remain gated.
DATAOPS_AUTO_HEAL_ENABLED=1
DATAOPS_AUTO_HEAL_INTERVAL_SECONDS=60
DATAOPS_AUTO_HEAL_REINDEX_PER_RUN=500
DATAOPS_AUTO_HEAL_REINDEX_PER_DAY=5000
DATAOPS_AUTO_HEAL_STALE_SECONDS=90
DATAOPS_AUTO_HEAL_MAX_RETRIES=3
DATAOPS_RESTORE_AUTO_ACTIVATE_STAGING=1
DATAOPS_RESTORE_REQUIRE_PRODUCTION_CONFIRMATION=1

# Optional encrypted database credential fallback; ENV aliases remain preferred.
DATAOPS_UI_CONFIG_ENABLED=1
DATAOPS_UI_SECRET_ENTRY_ENABLED=0
# DATAOPS_CONFIG_ENCRYPTION_KEY=<base64-url-safe 32-byte AES-256 key>

# AI provider policy. Stage can use real search answers while all other
# external effects remain sandboxed; production normally follows enabled.
# EXTERNAL_AI_MODE=enabled|sandbox|disabled
# OPENAI_API_KEY=<dokploy-secret>
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
