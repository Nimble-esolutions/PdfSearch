# Data Operations — canonical Dokploy environment contract
# ENV is authoritative. Values entered in the UI are database fallbacks only.
# Keep credentials in Dokploy secrets; this file intentionally contains none.

DATAOPS_ENABLED=1
# Canonical structured manifest. Compose passes this value verbatim to web and
# maintenance. Keep namespaces distinct whenever two profiles share a bucket.
DATAOPS_PROFILE_MANIFEST='[{"name":"production_restore","display_name":"Production restore source","role":"restore","endpoint":"https://s3.example.invalid","bucket":"ai-sahakar-prod-flowdocs-artifact-vault","region":"us-east-1","dataset_id":"flowdocs-prod","source_id":"prod","namespace":"production","credential_ref":"DATAOPS_PRODUCTION_RESTORE","enabled":true},{"name":"stage_backup","display_name":"Stage backup destination","role":"backup","endpoint":"https://s3.example.invalid","bucket":"ai-sahakar-prod-flowdocs-artifact-vault-v2","region":"us-east-1","dataset_id":"flowdocs-prod","source_id":"stage","namespace":"stage","credential_ref":"DATAOPS_STAGE_BACKUP","enabled":true}]'
# Legacy CSV + DATAOPS_PROFILE_<NAME>_* variables remain accepted during the
# migration window. New deployments should prefer DATAOPS_PROFILE_MANIFEST.
DATAOPS_ENV_PROFILES=production_restore,stage_backup

DATAOPS_BACKUP_PROFILE=stage_backup
DATAOPS_RESTORE_PROFILE=production_restore
DATAOPS_BACKUP_SOURCE_PROFILE=
DATAOPS_BACKUP_DESTINATION_PROFILE=
DATAOPS_RESTORE_SOURCE_PROFILE=
DATAOPS_RESTORE_DESTINATION_PROFILE=
DATAOPS_BACKUP_MODE=scheduled
DATAOPS_BACKUP_INTERVAL_SECONDS=900
DATAOPS_BACKUP_QUIET_PERIOD_SECONDS=120
DATAOPS_BACKUP_MAX_LAG_SECONDS=3600

# Safe automatic recovery. Restore and production activation remain gated.
DATAOPS_AUTO_HEAL_ENABLED=1
DATAOPS_AUTO_HEAL_INTERVAL_SECONDS=60
DATAOPS_AUTO_HEAL_REINDEX_PER_RUN=500
DATAOPS_AUTO_HEAL_REINDEX_PER_DAY=5000
DATAOPS_AUTO_HEAL_STALE_SECONDS=90
DATAOPS_AUTO_HEAL_MAX_RETRIES=3
DATAOPS_RESTORE_AUTO_ACTIVATE_STAGING=1
DATAOPS_RESTORE_REQUIRE_PRODUCTION_CONFIRMATION=1
DATAOPS_RESTORE_STAGING_ROOT=/var/lib/flowdocs/dataops-restore

# Optional encrypted database credential fallback; ENV aliases remain preferred.
DATAOPS_UI_CONFIG_ENABLED=1
DATAOPS_UI_SECRET_ENTRY_ENABLED=0
# DATAOPS_CONFIG_ENCRYPTION_KEY=<base64-url-safe 32-byte AES-256 key>

# AI provider policy. Stage can use real search answers while all other
# external effects remain sandboxed; production normally follows enabled.
# EXTERNAL_AI_MODE=enabled|sandbox|disabled
# OPENAI_API_KEY=<dokploy-secret>
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
