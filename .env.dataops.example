# Data Operations — canonical Dokploy environment contract
# ENV is authoritative. Values entered in the UI are database fallbacks only.
# Keep credentials in Dokploy secrets; this file intentionally contains none.

DATAOPS_ENABLED=1
# Canonical structured manifest. Compose passes this value verbatim to web and
# maintenance. Keep namespaces distinct whenever two profiles share a bucket.
DATAOPS_PROFILE_MANIFEST='[{"name":"production_v2_source","display_name":"Legacy production v2 source","role":"restore","provider":"rustfs","endpoint":"https://rustfs.example.invalid","bucket":"ai-sahakar-prod-flowdocs-artifact-vault-v2","region":"us-east-1","dataset_id":"ai-sahakar-prod-v2","source_id":"ai-sahakar-prod","namespace":"production-v2","credential_ref":"DATAOPS_PRODUCTION","enabled":true},{"name":"stage_2026","display_name":"2026 stage recovery vault","role":"both","provider":"rustfs","endpoint":"https://rustfs.example.invalid","bucket":"ai-sahakar-stage-2026-flowdocs-artifact-vault","region":"us-east-1","dataset_id":"ai-sahakar-stage-2026","source_id":"stage-2026","namespace":"stage-2026","credential_ref":"DATAOPS_PRODUCTION","enabled":true}]'
# Legacy CSV + DATAOPS_PROFILE_<NAME>_* variables remain accepted during the
# migration window. New deployments should prefer DATAOPS_PROFILE_MANIFEST.
DATAOPS_ENV_PROFILES=production_v2_source,stage_2026

DATAOPS_BACKUP_PROFILE=stage_2026
DATAOPS_RESTORE_PROFILE=stage_2026
DATAOPS_BACKUP_SOURCE_PROFILE=
DATAOPS_BACKUP_DESTINATION_PROFILE=
DATAOPS_RESTORE_SOURCE_PROFILE=
DATAOPS_RESTORE_DESTINATION_PROFILE=
# Keep this manual until the first stage backup receipt is verified; then the
# operator may change it to scheduled in the same reviewed ENV update.
DATAOPS_BACKUP_MODE=manual
DATAOPS_BACKUP_INTERVAL_SECONDS=900
DATAOPS_BACKUP_QUIET_PERIOD_SECONDS=120
DATAOPS_BACKUP_MAX_LAG_SECONDS=3600

# Safe automatic recovery. Restore and production activation remain gated.
DATAOPS_AUTO_HEAL_ENABLED=1
DATAOPS_AUTO_HEAL_INTERVAL_SECONDS=60
DATAOPS_AUTO_HEAL_REINDEX_PER_RUN=500
DATAOPS_AUTO_HEAL_REINDEX_PER_DAY=5000
DATAOPS_AUTO_HEAL_STALE_SECONDS=90
DATAOPS_AUTO_HEAL_MAX_RETRIES=3
DATAOPS_OPERATION_LEASE_SECONDS=3600
DATAOPS_RESTORE_AUTO_ACTIVATE_STAGING=1
DATAOPS_RESTORE_REQUIRE_PRODUCTION_CONFIRMATION=1
DATAOPS_RESTORE_STAGING_ROOT=/var/lib/flowdocs/dataops-restore
DATAOPS_CLONE_REBIND_ENABLED=0

# Public stage authentication is a permanent security exception.  The safe
# posture is private-only; approval requires all four non-secret evidence
# fields below and is never enabled by this example.
STAGE_PUBLIC_AUTH_EXCEPTION_REQUIRED=1
STAGE_PUBLIC_AUTH_EXCEPTION_APPROVED=0
STAGE_PUBLIC_AUTH_EXCEPTION_OWNER=
STAGE_PUBLIC_AUTH_EXCEPTION_MONITORING=
STAGE_PUBLIC_AUTH_EXCEPTION_INCIDENT_RESPONSE=
STAGE_PUBLIC_AUTH_EXCEPTION_ROLLBACK_AUTHORITY=

# Optional encrypted database credential fallback; ENV aliases remain preferred.
DATAOPS_UI_CONFIG_ENABLED=1
DATAOPS_UI_SECRET_ENTRY_ENABLED=0
# DATAOPS_CONFIG_ENCRYPTION_KEY=<base64-url-safe 32-byte AES-256 key>

# AI provider policy. Stage can use real search answers while all other
# external effects remain sandboxed; production normally follows enabled.
# EXTERNAL_AI_MODE=enabled|sandbox|disabled
# OPENAI_API_KEY=<dokploy-secret>
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# Local Compose supplies separate local_backup/local_restore selectors and
# DATAOPS_LOCAL_RUSTFS credentials. Do not copy those local-only values into
# stage or production.
