# Data Operations v3 — standard non-secret environment contract
#
# DataOps v3 has one owned recovery connection per dataset. Operators choose
# Backup, Restore, Test recovery, or Import; they do not configure source and
# destination profile selectors. Persist the connection through Data
# protection, or use the ARTIFACT_VAULT_* block below only to bootstrap it.

DATAOPS_ENABLED=1
APP_ENV=staging
DEPLOYMENT_ID=<stable-deployment-id>
DATASET_ID=<owned-dataset-id>

# Temporary owned-connection bootstrap. The endpoint and bucket are not
# secrets. Credentials remain in the deployment secret provider and are
# resolved by the worker only when an operation runs.
# DataOps v3 discovers the bootstrap from endpoint + bucket. Keep the older
# artifact adapter disabled unless a reviewed compatibility workflow needs it.
ARTIFACT_VAULT_ENABLED=0
ARTIFACT_VAULT_ENDPOINT=https://rustfs.example.invalid
ARTIFACT_VAULT_BUCKET=<owned-recovery-bucket>
ARTIFACT_VAULT_REGION=us-east-1
# ARTIFACT_VAULT_ACCESS_KEY=<deployment-secret>
# ARTIFACT_VAULT_SECRET_KEY=<deployment-secret>
# Standard Compose does not pass ARTIFACT_VAULT_SESSION_TOKEN. Use a static
# least-privilege access/secret pair until reviewed session-token wiring exists.

# Signed activation is separate from backup/import/restore. Keep it disabled
# until the target environment has the required pointer, signing, recovery,
# smoke-query, and rollback evidence.
STAGING_RUNTIME_ACTIVATION_ENABLED=0
STAGING_INITIAL_ACTIVATION_ENABLED=0
STAGING_ACTIVATION_APPLY_MODE=pending

# Legacy compatibility paths. Keep disabled in the standard v3 deployment.
# Their settings remain in code for focused compatibility tests and a temporary
# activation bridge; they are not a second operator product.
VAULT_SYNC_ENABLED=0
VAULT_RESTORE_ENABLED=0
VAULT_ADMIN_MUTATIONS_ENABLED=0
VAULT_UI_PROFILE_CONFIGURATION_ENABLED=0
VAULT_UI_SECRET_ENTRY_ENABLED=0

# Retired v2 profile choreography. Leave blank; do not copy old profile
# manifests or backup/restore selectors into a new v3 deployment.
DATAOPS_PROFILE_MANIFEST=
DATAOPS_ENV_PROFILES=
DATAOPS_BACKUP_PROFILE=
DATAOPS_RESTORE_PROFILE=
DATAOPS_BACKUP_SOURCE_PROFILE=
DATAOPS_BACKUP_DESTINATION_PROFILE=
DATAOPS_RESTORE_SOURCE_PROFILE=
DATAOPS_RESTORE_DESTINATION_PROFILE=
